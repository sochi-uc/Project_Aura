[Unit]
Description=Project Aura - Telegram Message Processing Worker
After=postgresql.service

[Service]
Type=oneshot
# Replace YOUR_USER and /path/to/Project_Aura with your actual username and directory
User=YOUR_USER
WorkingDirectory=/path/to/Project_Aura
EnvironmentFile=/path/to/Project_Aura/.env
ExecStart=/path/to/Project_Aura/venv/bin/python worker/process.py
