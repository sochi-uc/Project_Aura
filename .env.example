# ==========================================
# Project Aura - Environment Configuration
# ==========================================

# Telegram User API (from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Telethon User Session String (generate by running: python generate_session.py)
TELEGRAM_SESSION_STRING=your_telethon_session_string

# Telegram Bot Token (from @BotFather on Telegram)
ASSISTANT_BOT_TOKEN=your_bot_token

# Authorized Owner Telegram ID (get numeric ID from @userinfobot on Telegram)
TELEGRAM_USER_ID=your_numeric_telegram_user_id

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# Optional / Fallback LLM Key (if using Groq or alternative)
LLM_API_KEY=

# PostgreSQL with pgvector extension enabled
DATABASE_URL=postgresql://user:password@localhost:5432/tg_assistant
