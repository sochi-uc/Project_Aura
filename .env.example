# ==========================================
# Project Aura - Environment Configuration
# ==========================================

# ── Telegram Credentials ─────────────────
# User API (from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Telethon User Session String (generate with: python generate_session.py)
TELEGRAM_SESSION_STRING=your_telethon_session_string

# Telegram Bot Token (from @BotFather)
ASSISTANT_BOT_TOKEN=your_bot_token

# Authorized Owner Telegram ID (get numeric ID from @userinfobot)
TELEGRAM_USER_ID=your_numeric_telegram_user_id

# ── Database (PostgreSQL + pgvector) ─────
DATABASE_URL=postgresql://user:password@localhost:5432/aura_db

# ── LLM Provider Abstraction ────────────
# Active provider: gemini | groq | openai | mock
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Groq Configuration (Ultra-fast Llama 3 inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI / OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter, LocalAI)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Embedding Provider Abstraction ───────
# Active provider: sentence_transformers | mock
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Processing Pipeline Parameters ───────
BATCH_SIZE=50
SIMILARITY_THRESHOLD_LOW=0.65
SIMILARITY_THRESHOLD_HIGH=0.65
